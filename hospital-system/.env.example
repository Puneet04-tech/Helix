# Hospital System Environment Configuration

# Hospital Details
HOSPITAL_NAME=City Medical Center
HOSPITAL_ID=hosp_001
LOCATION=Downtown

# Helix Integration (Get these from Helix Dashboard)
HELIX_API_URL=https://helix-ujly.onrender.com
HELIX_API_KEY=pk_hospital_001_xxxxxxxxxxxxx
HELIX_PROJECT_ID=hospital_001
HELIX_WEBHOOK_SECRET=your-webhook-hmac-secret

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hospital_system

# Backend Server
PORT=5001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here

# Frontend
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_HELIX_URL=https://helix-ujly.onrender.com
NEXT_PUBLIC_PROJECT_ID=hospital_001

# Email Configuration (Optional - for staff alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Logging
LOG_LEVEL=debug
