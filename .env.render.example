# Render Production Environment Variables Template
# Copy these to Render Dashboard: Settings → Build & Deploy → Environment

# ==========================================
# DATABASE
# ==========================================
# Get connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/helix-prod?retryWrites=true&w=majority

# ==========================================
# AUTHENTICATION & SECURITY
# ==========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_should_be_32_bytes_base64_encoded

# JWT token expiration
JWT_EXPIRATION=24h

# ==========================================
# GROQ AI CONFIGURATION
# ==========================================
# Get from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ==========================================
# OLLAMA (Optional - Local LLM Fallback)
# ==========================================
# Only if running Ollama on Render or private network
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=mistral

# ==========================================
# HUGGINGFACE API (LLM Fallback)
# ==========================================
# Get token from https://huggingface.co/settings/tokens
HUGGING_FACE_API_TOKEN=hf_your_huggingface_token_here
HUGGING_FACE_MODEL=mistralai/Mistral-7B-Instruct-v0.1

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Gmail: Use app-specific password, not your main password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_specific_password
EMAIL_FROM=noreply@helix-alerts.com

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
# Production settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ==========================================
# CORS & FRONTEND
# ==========================================
# Match your Netlify domain exactly
CORS_ORIGIN=https://your-netlify-site.netlify.app

# ==========================================
# BUSINESS LOGIC THRESHOLDS
# ==========================================
# Number of events before triggering analysis
INCIDENT_THRESHOLD=3

# Pattern matching confidence (0-1)
PATTERN_MATCH_THRESHOLD=0.75

# Anomaly detection sensitivity (0-1)
ANOMALY_SENSITIVITY=0.8

# ==========================================
# OPTIONAL: MONITORING & LOGGING
# ==========================================
# Sentry error tracking
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# SendGrid for emails (alternative to SMTP)
# SENDGRID_API_KEY=SG.your_sendgrid_key

# ==========================================
# OPTIONAL: ANALYTICS
# ==========================================
# Google Analytics
GA_TRACKING_ID=your_ga_id

# Datadog APM (if using)
# DD_AGENT_HOST=localhost
# DD_TRACE_AGENT_PORT=8126
