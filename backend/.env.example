# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/helix
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/helix

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# AI Services
HUGGINGFACE_API_KEY=hf_your_api_key_here

# Groq AI (recommended - fastest free tier, 30K TPM)
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Gemini AI (frontier quality, 5 RPM limit)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Mistral AI (good quality, 1B tokens/month free)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Ollama (local fallback - no API costs, slower)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Webhook Security (optional — hospital/hotel integrations)
HELIX_WEBHOOK_SECRET=your-webhook-hmac-secret

# Email (Nodemailer - Gmail)
NODEMAILER_EMAIL=your-email@gmail.com
NODEMAILER_PASS=your-16-char-app-password

# Render Deployment
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/your-service-id

# Cache and Temp  
CACHE_DIR=./.cache
TEMP_DIR=./.temp

# Playwright Configuration
PLAYWRIGHT_BROWSERS_PATH=./.cache/playwright
