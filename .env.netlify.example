# Netlify Production Environment Variables Template
# Add these in Netlify Dashboard: Site Settings → Build & Deploy → Environment

# ==========================================
# BACKEND API CONFIGURATION
# ==========================================
# Your Render backend URL
NEXT_PUBLIC_API_URL=https://your-render-name.onrender.com

# WebSocket endpoint for real-time updates
NEXT_PUBLIC_WS_URL=wss://your-render-name.onrender.com
NEXT_PUBLIC_WS_PATH=/socket.io

# ==========================================
# BUILD CONFIGURATION
# ==========================================
# Must be production for optimized build
NODE_ENV=production

# Increase Node memory for large builds
NODE_OPTIONS=--max_old_space_size=4096

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
# UI Settings
NEXT_PUBLIC_APP_NAME=Helix
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=production

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable features in dashboard
NEXT_PUBLIC_ENABLE_LIVE_DEMO=true
NEXT_PUBLIC_ENABLE_CHAT_BOT=true
NEXT_PUBLIC_ENABLE_INCIDENT_CORRELATION=true
NEXT_PUBLIC_ENABLE_EXPORT_INCIDENTS=true

# ==========================================
# AUTHENTICATION
# ==========================================
# Where to store JWT token (localStorage or sessionStorage)
NEXT_PUBLIC_TOKEN_STORAGE=localStorage

# Key name for storing auth token
NEXT_PUBLIC_AUTH_TOKEN_KEY=helix_auth_token

# Auto-refresh token before expiry (minutes)
NEXT_PUBLIC_TOKEN_REFRESH_INTERVAL=60

# ==========================================
# MONITORING & ANALYTICS
# ==========================================
# Google Analytics ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry error tracking (frontend monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_key@sentry.io/project_id

# Sentry environment
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# ==========================================
# UI/UX CONFIGURATION
# ==========================================
# Dashboard refresh interval (seconds)
NEXT_PUBLIC_DASHBOARD_REFRESH_INTERVAL=5

# Events page pagination size
NEXT_PUBLIC_EVENTS_PAGE_SIZE=20

# Incidents page pagination size
NEXT_PUBLIC_INCIDENTS_PAGE_SIZE=15

# Real-time update timeout (ms)
NEXT_PUBLIC_WEBSOCKET_TIMEOUT=5000

# ==========================================
# OPTIONAL: API CONFIGURATION
# ==========================================
# Request timeout (ms)
NEXT_PUBLIC_API_TIMEOUT=30000

# Enable API debug logging in console
NEXT_PUBLIC_API_DEBUG=false

# ==========================================
# OPTIONAL: THEME CONFIGURATION
# ==========================================
# Default theme (light/dark)
NEXT_PUBLIC_DEFAULT_THEME=light

# Brand colors (hex codes)
# NEXT_PUBLIC_PRIMARY_COLOR=#3B82F6
# NEXT_PUBLIC_SECONDARY_COLOR=#1E40AF

# ==========================================
# CACHE SETTINGS
# ==========================================
# Cache control for static assets
NEXT_PUBLIC_CACHE_CONTROL=public, max-age=3600

# Service Worker enabled for offline support
NEXT_PUBLIC_ENABLE_PWA=true
